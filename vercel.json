{
  "regions": [
    "fra1"
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/index.html.md",
      "headers": [
        {
          "key": "Link",
          "value": "<https://www.mirdyne.com/>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/:page/index.html.md",
      "headers": [
        {
          "key": "Link",
          "value": "<https://www.mirdyne.com/:page/>; rel=\"canonical\""
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "prism.mirdyne.com"
        }
      ],
      "destination": "https://www.mirdyne.com/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.mirdyne.eu"
        }
      ],
      "destination": "https://www.mirdyne.com/",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "mirdyne.eu"
        }
      ],
      "destination": "https://www.mirdyne.com/",
      "permanent": true
    },
    {
      "source": "/evidence",
      "destination": "/method/#proof",
      "permanent": false
    },
    {
      "source": "/evidence/",
      "destination": "/method/#proof",
      "permanent": false
    },
    {
      "source": "/evidence/:path+",
      "destination": "/method/#proof",
      "permanent": false
    },
    {
      "source": "/about",
      "destination": "/company/",
      "permanent": true
    },
    {
      "source": "/about/",
      "destination": "/company/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/platform",
      "destination": "/platform/index.html"
    },
    {
      "source": "/method",
      "destination": "/method/index.html"
    },
    {
      "source": "/company",
      "destination": "/company/index.html"
    },
    {
      "source": "/news",
      "destination": "/news/index.html"
    },
    {
      "source": "/interest",
      "destination": "/interest/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/impressum",
      "destination": "/impressum/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/deck",
      "destination": "/deck/index.html"
    },
    {
      "source": "/install.sh",
      "destination": "https://raw.githubusercontent.com/Darth-Hidious/PRISM/main/install.sh"
    },
    {
      "source": "/install.ps1",
      "destination": "https://raw.githubusercontent.com/Darth-Hidious/PRISM/main/install.ps1"
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)[Tt][Ee][Xx][Tt]/[Mm][Aa][Rr][Kk][Dd][Oo][Ww][Nn](.*)"
        }
      ],
      "destination": "/api/not-found"
    }
  ],
  "crons": [
    {
      "path": "/api/interest-cleanup",
      "schedule": "17 3 * * *"
    }
  ]
}
