{
  "regions": [
    "fra1"
  ],
  "redirects": [
    {
      "source": "/evidence",
      "destination": "/method/#proof",
      "permanent": false
    },
    {
      "source": "/evidence/",
      "destination": "/method/#proof",
      "permanent": false
    },
    {
      "source": "/evidence/:path+",
      "destination": "/method/#proof",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/platform",
      "destination": "/platform/index.html"
    },
    {
      "source": "/method",
      "destination": "/method/index.html"
    },
    {
      "source": "/company",
      "destination": "/company/index.html"
    },
    {
      "source": "/news",
      "destination": "/news/index.html"
    },
    {
      "source": "/interest",
      "destination": "/interest/index.html"
    },
    {
      "source": "/deck",
      "destination": "/deck/index.html"
    },
    {
      "source": "/install.sh",
      "destination": "https://raw.githubusercontent.com/Darth-Hidious/PRISM/main/install.sh"
    },
    {
      "source": "/install.ps1",
      "destination": "https://raw.githubusercontent.com/Darth-Hidious/PRISM/main/install.ps1"
    }
  ],
  "crons": [
    {
      "path": "/api/interest-cleanup",
      "schedule": "17 3 * * *"
    }
  ]
}
